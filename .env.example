# AI Prof — Production Environment Variable Configuration

# API Server & Environment Settings
ENVIRONMENT=production
PROJECT_NAME="AI Prof — Adaptive SaaS Learning Platform"
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Storage (Supabase / Managed PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis (Managed Redis Service / Render Redis)
REDIS_URL=redis://default:your-redis-password@your-redis-host.render.com:6379

# AI Providers (Groq & Gemini Free Tier / Paid API Keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Security & CORS
CORS_ORIGINS=["https://ai-prof.vercel.app","http://localhost:3000","http://localhost:5173"]

# Vector Store (ChromaDB / Managed Vector Engine)
CHROMA_DB_DIR=./data/chromadb
EMBEDDING_MODEL=all-MiniLM-L6-v2
